<?xml version="1.0" encoding="UTF-8"?>
<lerobot>
  <!-- Cada arg es un argumento independiente, sin comillas de shell.
       Configuración del brazo y cámaras proporcionada para follower_robotekin.
       Puedes adaptar este comando si usáis otro ejecutor de LeRobot. -->
  <command>
    <arg>{python}</arg>
    <arg>-m</arg>
    <arg>lerobot.scripts.lerobot_rollout</arg>
    <arg>--strategy.type=base</arg>
    <arg>--robot.type=so101_follower</arg>
    <arg>--robot.port=/dev/ttyACM1</arg>
    <arg>--robot.id=follower_robotekin</arg>
    <arg>--robot.calibration_dir=/home/daviluud/.cache/huggingface/lerobot/calibration/robots/so_follower</arg>
    <arg>--robot.cameras={ top: {type: opencv, index_or_path: /dev/video6, width: 640, height: 480, fps: 30}, wrist: {type: opencv, index_or_path: /dev/video4, width: 640, height: 480, fps: 30}}</arg>
    <arg>--policy.path={policy}</arg>
    <arg>--policy.n_action_steps=1</arg>
    <arg>--policy.temporal_ensemble_coeff=0.01</arg>
    <arg>--task={task}</arg>
    <arg>--duration={duration}</arg>
    <arg>--display_data=false</arg>
  </command>
  <!-- policy: usuario/modelo en Hugging Face o ruta a pretrained_model.
       Las rutas locales relativas deben empezar por ./ o ../ y se resuelven
       respecto a este XML. duration son segundos de ejecución (ajustar). -->
  <models>
    <!-- La secuencia de pedidos usa solo vaso amarillo, tenedor y cuchara.
         El cuchillo se conserva como opción fuera de esa secuencia. -->
    <model id="coger_vaso_amarillo" policy="" task="Pick up the yellow cup and place it next to the plate" duration="60"/>
    <model id="coger_tenedor" policy="" task="Pick up the fork and place it next to the plate" duration="60"/>
    <model id="coger_cuchillo" policy="" task="Pick up the knife and place it next to the plate" duration="60"/>
    <model id="coger_cuchara" policy="" task="Pick up the spoon and place it next to the plate" duration="60"/>
  </models>
</lerobot>
